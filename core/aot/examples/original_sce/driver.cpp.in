#include <sys/sysctl.h>
extern "C" {
extern const NativeAotGuestImage app___aps5_guest_image;
extern const NativeAotGuestImage shim___aps5_guest_image;
extern const void* OriginalNativeBindings[];
void Aps5StartGuest_nid_no_patch(void (*)(void*,void*),void*);
void exit_nid_postfix(int);
int __cxa_atexit_nid_postfix(void (*)(void*),void*,void*);
}
namespace {
std::unique_ptr<NativeAotBundleRegistry> lifecycle;
GuestTlsDescriptor moduleTls{};
int argumentCount;
char** argumentValues;
unsigned frames=0;
void InitializeModule() { NativeAotSce::InvokeCallback(*shim___aps5_guest_image.Base + INIT_ADDRESS); std::fprintf(stderr,"original module initialized\n"); }
void FinalizeModule() { NativeAotSce::InvokeCallback(*shim___aps5_guest_image.Base + FINI_ADDRESS); std::fprintf(stderr,"original module finalized\n"); }
void Stop(void*) { lifecycle->Stop(); std::fprintf(stderr,"original SCE bundle teardown completed\n"); }
void Boundary(const char* name,const NativeAotGuestState& state) {
    if (static_cast<std::int32_t>(state.Gpr[0]) != 0) return;
    const auto* text=std::getenv("ANYPS5_TEST_FRAME_LIMIT");
    const auto limit=text ? std::strtoul(text,nullptr,10) : 0;
    if (limit>1) std::_Exit(93);
    if (std::strcmp(name,"sceVideoOutWaitVblank")==0) ++frames;
    if(limit && frames >= limit && (limit>1 || std::strcmp(name,"sceKernelUsleep")==0)) { std::fprintf(stderr,"host requested stop after %u vblanks\n",frames); exit_nid_postfix(0); }
}
void Entry(void*,void*) {
    const NativeAotSce::Binding bindings[] = {
ROWS
    };
    NativeAotSce::Register(bindings);
    const NativeAotGuest::ImageBinding images[]={{&app___aps5_guest_image,NativeAotGuest::Abi::SceApplication},
        {&shim___aps5_guest_image,NativeAotGuest::Abi::SceModule,&moduleTls}};
    NativeAotGuest::LoadBundle(images,0);
    std::vector<NativeAotDataRange> appRanges,shimRanges;
    for(const auto* image:{&app___aps5_guest_image,&shim___aps5_guest_image}) {
        auto& ranges=image==&app___aps5_guest_image ? appRanges : shimRanges;
        for(std::uint64_t i=0;i<image->SegmentCount;++i) ranges.push_back({reinterpret_cast<const void*>(*image->Base+image->Segments[i].Address),image->Segments[i].MemorySize});
    }
    const NativeAotImage metadata{1,appRanges.data(),appRanges.size(),nullptr,0,reinterpret_cast<const void*>(*app___aps5_guest_image.Base+PROCESS_ADDRESS),PROCESS_BYTES};
    NativeAotRegisterImage_nid_no_patch(&metadata);
    const NativeAotModuleDependency dependency{1,257};
    const void* functions[]={reinterpret_cast<const void*>(InitializeModule),reinterpret_cast<const void*>(FinalizeModule)};
    const NativeAotLifecycleFunction initializers[]={InitializeModule},finalizers[]={FinalizeModule};
    NativeAotModule modules[2]{};
    modules[0].descriptorVersion=3;modules[0].id="app";modules[0].moduleVersion=1;
    modules[0].ranges=appRanges.data();modules[0].rangeCount=appRanges.size();modules[0].dependencies=&dependency;modules[0].dependencyCount=1;
    modules[1].descriptorVersion=3;modules[1].id="libc";modules[1].moduleVersion=257;modules[1].ranges=shimRanges.data();modules[1].rangeCount=shimRanges.size();
    modules[1].functions=functions;modules[1].functionCount=2;modules[1].initializers=initializers;modules[1].initializerCount=1;modules[1].finalizers=finalizers;modules[1].finalizerCount=1;
    modules[1].tls=&moduleTls;modules[1].tlsBytes=shim___aps5_guest_image.TlsMemorySize;
    lifecycle=std::make_unique<NativeAotBundleRegistry>(modules,0);
    lifecycle->Start();
    __cxa_atexit_nid_postfix(Stop,nullptr,nullptr);
    NativeAotSce::SetBoundaryObserver(Boundary);
    NativeAotGuest::StartSceApplication(app___aps5_guest_image,argumentCount,argumentValues);
}
}
int main(int argc,char** argv) {
    int translated=0;std::size_t bytes=sizeof(translated);
    if(sysctlbyname("sysctl.proc_translated",&translated,&bytes,nullptr,0)!=0 && errno!=ENOENT) return 90;
    if(translated) return 91;
    std::fprintf(stderr,"architecture=arm64 translated=%d original-inputs=2\n",translated);
    argumentCount=argc;argumentValues=argv;
    Aps5StartGuest_nid_no_patch(Entry,nullptr);
}
